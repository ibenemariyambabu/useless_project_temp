# ==============================================================================
# BLINKOS FRONTEND ENVIRONMENT CONFIGURATION (VERCEL & PRODUCTION)
# ==============================================================================

# 1. Server-Side Rewrites URL
# The URL of your deployed FastAPI backend (e.g. Railway, Render, Fly.io, or VPS)
# When set, Next.js rewrites all /api/* calls to this server.
# Leave blank to use built-in Next.js Serverless Route Handlers in standalone mode.
BACKEND_URL=https://your-backend.up.railway.app

# 2. Client-Side API Override (Optional)
# Leave blank or set to /api on Vercel to use relative routing.
NEXT_PUBLIC_API_URL=/api

# 3. Client-Side WebSocket URL (Optional)
# For real-time multiplayer room synchronization.
# Example for production: wss://your-backend.up.railway.app
# Example for localhost: ws://localhost:8000
NEXT_PUBLIC_WS_URL=wss://your-backend.up.railway.app
